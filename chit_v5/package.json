{
  "name": "chit-app-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "test:unit": "jest --runInBand",
    "test:integration": "npm run test:schema && npm run test:financial && npm run test:http",
    "test:schema": "jest --config ./test/jest-e2e.json --runInBand test/integration/schema-contract.e2e-spec.ts",
    "test:seed": "ts-node ./test/seed-test-db.ts",
    "validate": "npm run build && npm run test:schema",
    "test:financial": "jest --config ./test/jest-e2e.json --runInBand test/integration/financial-invariants.e2e-spec.ts test/integration/ledger-reconciliation.e2e-spec.ts test/integration/month-lock.e2e-spec.ts",
    "test:http": "jest --config ./test/jest-e2e.json --runInBand test/integration/http-contract.e2e-spec.ts",
    "test:http:auth": "jest --config ./test/jest-e2e.json --runInBand test/integration/authenticated-financial.e2e-spec.ts",
    "test:concurrency": "jest --config ./test/jest-e2e.json --runInBand test/integration/concurrency-contract.e2e-spec.ts test/integration/idempotency-concurrency.e2e-spec.ts",
    "test:rc": "npm run test:integration && npm run test:http:auth && npm run test:concurrency && npm run test:real-http && npm run test:lifecycle && npm run test:reconciliation && npm run test:final && npm run test:security && npm run test:ops && npm run test:infra",
    "test:real-http": "jest --config ./test/jest-e2e.json --runInBand test/integration/real-financial-flow.e2e-spec.ts test/integration/agent-month-invariants.e2e-spec.ts",
    "test:lifecycle": "jest --config ./test/jest-e2e.json --runInBand test/integration/payment-lifecycle.e2e-spec.ts test/integration/fixed-draw-payout-lifecycle.e2e-spec.ts test/integration/auction-payout-lifecycle.e2e-spec.ts",
    "test:reconciliation": "jest --config ./test/jest-e2e.json --runInBand test/integration/reconciliation-default-close.e2e-spec.ts test/integration/agent-ledger-reconciliation.e2e-spec.ts test/integration/financial-reconciliation-report.e2e-spec.ts",
    "test:final": "jest --config ./test/jest-e2e.json --runInBand test/integration/end-of-chit-reconciliation.e2e-spec.ts test/integration/security-regression.e2e-spec.ts",
    "test:security": "jest --config ./test/jest-e2e.json --runInBand test/integration/idor-security.e2e-spec.ts test/integration/financial-authorization.e2e-spec.ts test/integration/security-config.e2e-spec.ts",
    "test:ops": "jest --config ./test/jest-e2e.json --runInBand test/integration/notifications-operations.e2e-spec.ts",
    "test:infra": "jest --config ./test/jest-e2e.json --runInBand test/integration/production-config.e2e-spec.ts",
    "test:release-audit": "jest --config ./test/jest-e2e.json --runInBand test/integration/release-audit.e2e-spec.ts test/integration/financial-release-invariants.e2e-spec.ts test/integration/swagger-audit.e2e-spec.ts",
    "test:release": "npm run test:rc && npm run test:release-audit && npm run test:v42 && npm run test:v43 && npm run test:v44 && npm run test:preflight && npm run test:v46 && npm run test:v47 && npm run test:v48 && npm run test:v49 && npm run test:v52 && npm run test:v53",
    "test:v42": "jest --config ./test/jest-e2e.json --runInBand test/integration/payment-collection-v42.e2e-spec.ts",
    "test:v43": "jest --config ./test/jest-e2e.json --runInBand test/integration/chit-import-v43.e2e-spec.ts",
    "test:v44": "jest --config ./test/jest-e2e.json --runInBand test/integration/chit-import-reconciliation-v44.e2e-spec.ts",
    "test:preflight": "jest --config ./test/jest-e2e.json --runInBand test/integration/final-release-preflight.e2e-spec.ts",
    "test:v46": "jest --config ./test/jest-e2e.json --runInBand test/integration/payment-proof-v46.e2e-spec.ts",
    "test:v47": "jest --config ./test/jest-e2e.json --runInBand test/integration/chit-chat-v47.e2e-spec.ts",
    "test:v48": "jest --config ./test/jest-e2e.json --runInBand test/integration/chit-chat-v48.e2e-spec.ts",
    "test:v49": "jest --config ./test/jest-e2e.json --runInBand test/integration/v49-hardening.e2e-spec.ts",
    "audit:release": "npm run build && npm run test:release",
    "release:final": "npm run build && npm run test:release",
    "release:preflight": "npm run release:final",
    "test:v52": "jest --config ./test/jest-e2e.json --runInBand test/integration/v52-agent-portfolio.e2e-spec.ts",
    "test:v53": "jest --config ./test/jest-e2e.json --runInBand test/integration/v53-agent-dashboard.e2e-spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sequelize": "^6.37.5",
    "sequelize-typescript": "^2.1.6",
    "@nestjs/sequelize": "^11.0.0",
    "@nestjs/websockets": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "socket.io": "^4.8.1",
    "@nestjs/schedule": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "jest": "^29.7.0",
    "sequelize-cli": "^6.6.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
